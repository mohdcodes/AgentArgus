# Copy to .env (gitignored) and fill in — the examples read these from the env.
# AgentArgus core ships NO LLM client; the examples inject one via this key.
# NEVER put a real key in this file — .env.example is committed to git.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model the examples use (defaults to claude-opus-4-8).
# AGENTARGUS_EXAMPLE_MODEL=claude-opus-4-8
