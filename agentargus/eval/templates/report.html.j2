<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>AgentArgus Eval Report</title>
  <style>
    :root { color-scheme: light dark; }
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
           margin: 0; padding: 2rem; line-height: 1.5; }
    h1 { margin: 0 0 1rem; font-size: 1.5rem; }
    h2 { margin: 2rem 0 0.5rem; font-size: 1.1rem; }
    table { border-collapse: collapse; width: 100%; margin: 0.5rem 0; }
    th, td { border: 1px solid #8884; padding: 0.4rem 0.6rem; text-align: left;
             font-variant-numeric: tabular-nums; }
    th { background: #8881; }
    .cards { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0.5rem 0 1rem; }
    .card { border: 1px solid #8884; border-radius: 8px; padding: 0.75rem 1rem; min-width: 8rem; }
    .card .label { font-size: 0.8rem; opacity: 0.7; }
    .card .value { font-size: 1.4rem; font-weight: 600; }
    .regress { color: #c0392b; font-weight: 600; }
    .ok { color: #1e8449; }
    .fail-row { background: #c0392b22; }
    .muted { opacity: 0.6; }
    .wrap { overflow-x: auto; }
  </style>
</head>
<body>
  <h1>AgentArgus — Evaluation Report</h1>

  <h2>Summary</h2>
  <div class="cards">
    {% for name in metric_names %}
      {% if name in summary %}
      <div class="card">
        <div class="label">{{ name }}</div>
        <div class="value">{{ "%.3f"|format(summary[name]) }}</div>
      </div>
      {% endif %}
    {% endfor %}
    <div class="card">
      <div class="label">cases</div>
      <div class="value">{{ summary["_cases"]|int }}</div>
    </div>
    <div class="card">
      <div class="label">failures</div>
      <div class="value">{{ summary["_failures"]|int }}</div>
    </div>
    <div class="card">
      <div class="label">total cost</div>
      <div class="value">${{ "%.4f"|format(summary["_total_cost_usd"]) }}</div>
    </div>
  </div>

  {% if regressions %}
  <h2 class="regress">Regressions</h2>
  <table>
    <tr><th>Metric</th><th>Delta vs. baseline</th></tr>
    {% for name, delta in regressions.items() %}
    <tr><td>{{ name }}</td><td class="regress">{{ "%.3f"|format(delta) }}</td></tr>
    {% endfor %}
  </table>
  {% else %}
  <p class="ok">No regressions detected.</p>
  {% endif %}

  <h2>Per-case</h2>
  <div class="wrap">
  <table>
    <tr>
      <th>#</th><th>Question</th>
      {% for name in metric_names %}<th>{{ name }}</th>{% endfor %}
      <th>Cost</th><th>Status</th>
    </tr>
    {% for cr in case_results %}
    <tr class="{{ 'fail-row' if cr.failed else '' }}">
      <td>{{ loop.index }}</td>
      <td>{{ cr.case.question }}</td>
      {% for name in metric_names %}
        <td>{{ "%.3f"|format(cr.scores[name]) if name in cr.scores else "—" }}</td>
      {% endfor %}
      <td>{{ "$%.4f"|format(cr.result.cost.total_cost) if cr.result else "—" }}</td>
      <td>{{ cr.error if cr.failed else "ok" }}</td>
    </tr>
    {% endfor %}
  </table>
  </div>
</body>
</html>
